menu "App"

	config DEMO_TEST
		bool "Enable Demo Test"
		default n

	#TODO does UPGRADE here means OTA?
	config FTPD_UPGRADE
		bool "Enable Ftpd Upgrade"
		default n

	# Lab/demo only. No credential is built in: both values default
	# empty, and an empty username or password refuses every login
	# (fail closed). Set a device-specific pair before enabling FTP
	# outside a lab. Do not ship a well-known demo password.
	config FTPD_USERNAME
		string "FTP daemon username"
		depends on FTPD_UPGRADE
		default ""
		help
			Lab/demo only. Compile-time FTP username
			(CONFIG_FTPD_USERNAME). Leave empty to refuse every login.

	config FTPD_PASSWORD
		string "FTP daemon password"
		depends on FTPD_UPGRADE
		default ""
		help
			Lab/demo only. Compile-time FTP password
			(CONFIG_FTPD_PASSWORD). An empty client password is never
			accepted. An empty value here also refuses every login
			(fail closed).

	config OTA_HTTP
		depends on WIFI_ENABLE
		bool "Enable Ota Http"
		default y if NO_HOSTED
		default n if !NO_HOSTED

	#TODO what's the relationship between HTTP and TFTP OTA, exculsive?
	config OTA_TFTP
		bool "Enable Ota Tftp"
		default n

	config NTP_SYNC_RTC
		depends on AON_RTC
		bool "Enable Ntp Sync Rtc"
		default n

	config SECURITY_OTA
		bool "Enable Seucirty Ota API"
		default n

endmenu
